{
  "$schema": "https://raw.githubusercontent.com/denoland/deno/refs/heads/main/cli/schemas/config-file.v1.json",
  "imports": {
    "@std/assert": "jsr:@std/assert@1",
    "effect": "npm:effect@4.0.0-rc.113"
  },
  "workspace": ["./packages/*", "./extensions/*", "./tools/*"],
  "nodeModulesDir": "auto",
  "lint": {
    "rules": {
      "exclude": ["no-slow-types", "no-explicit-any"]
    }
  }
